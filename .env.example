# Copy this file to .env and fill in your keys. Never commit .env.

# Needed
GEMINI_API_KEY=
TAVILY_API_KEY=

# Recommended. Without these the app still runs:
# no Serper = Tavily finds the person; no Hunter = email stays blank.
SERPER_API_KEY=
HUNTER_API_KEY=

# Optional. If set, Claude does the need reasoning and writing, and Gemini tests the result.
ANTHROPIC_API_KEY=

# Optional. Uses your Claude Code login instead of any AI key. Only works on the computer running the app.
# AI_BACKEND=claude-code

# Optional
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_DEEP_MODEL=gemini-3.6-flash
# HOOK_THRESHOLD=60
# DATABASE_PATH=drafter.db
# SELLER_PROFILE=seller/zamp.json

# Optional. Lets people send from their own Gmail. See the README.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/gmail/callback
# Any long random text. It protects saved Gmail connections.
# TOKEN_KEY=
